# HireMind AI Environment Configuration
# API Keys (Set GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider Choice: "gemini", "openai", or "mock" (auto-fallback if key missing)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
PORT=5000
